{
  "name": "@tyson1403/playwright-automation-platform",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyson1403/playwright-automation-platform.git"
  },
  "description": "Reusable Playwright test platform: one pinned Playwright version, a shared config factory and reusable fixtures for many test projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@playwright/test": "1.63.0"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "sdet",
    "qa",
    "shared-config"
  ],
  "homepage": "https://github.com/tyson1403/playwright-automation-platform#readme",
  "bugs": {
    "url": "https://github.com/tyson1403/playwright-automation-platform/issues"
  },
  "author": "tyson1403"
}
